rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // AUTHENTICATION & ROLE HELPER FUNCTIONS
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return userDocExists() ? getUserData().role : 'customer';
    }

    function isUserActive() {
      return !userDocExists() || (getUserData().status != 'suspended');
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'superAdmin' ||
        (userDocExists() && getUserRole() == 'superAdmin')
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        request.auth.token.role == 'admin' ||
        (userDocExists() && (getUserRole() == 'admin' || getUserRole() == 'superAdmin')) ||
        request.auth.token.email in ['mikiyaswoyne@gmail.com', 'admin@jjbookstore.com', 'admin@jjbookshopping.com']
      );
    }

    function isEmployee() {
      return isSignedIn() && isUserActive() && (
        isAdmin() ||
        request.auth.token.role in ['staff', 'employee', 'delivery'] ||
        (userDocExists() && getUserRole() in ['staff', 'employee', 'delivery'])
      );
    }

    function isDeliveryStaff() {
      return isSignedIn() && isUserActive() && (
        isAdmin() ||
        request.auth.token.role == 'delivery' ||
        (userDocExists() && (
          ('assignedRoles' in getUserData() && 'delivery_personnel' in getUserData().assignedRoles) ||
          getUserRole() in ['delivery', 'staff', 'employee']
        ))
      );
    }

    // ===============================================================
    // 1. USERS & PROFILES
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isEmployee();

      allow create: if (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == 'customer'))
                    || isAdmin();

      allow update: if (isOwner(userId)
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.status == resource.data.status
                        && (!('permissions' in request.resource.data) || request.resource.data.permissions == resource.data.permissions)
                        && (!('assignedRoles' in request.resource.data) || request.resource.data.assignedRoles == resource.data.assignedRoles))
                    || isAdmin();

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 2. EMPLOYEES & STAFF DIRECTORY
    // ===============================================================
    match /employees/{employeeId} {
      allow read: if isEmployee();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (isEmployee() && (resource.data.uid == request.auth.uid || employeeId == request.auth.uid)
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.permissions == resource.data.permissions
                        && request.resource.data.assignedRoles == resource.data.assignedRoles
                        && request.resource.data.active == resource.data.active);
    }

    // ===============================================================
    // 3. BOOK CATALOG
    // ===============================================================
    match /books/{bookId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isEmployee();
    }

    // ===============================================================
    // 4. AUTHORS & CATEGORIES
    // ===============================================================
    match /authors/{authorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===============================================================
    // 5. COUPONS & PROMOTIONS
    // ===============================================================
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===============================================================
    // 6. CARTS & WISHLISTS
    // ===============================================================
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /wishlists/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ===============================================================
    // 7. ORDERS & CHECKOUT (FINANCIAL & STATUS SECURITY ENFORCED)
    // ===============================================================
    match /orders/{orderId} {
      // Read access: Staff/Admin, Order Owner, or Assigned Driver
      allow read: if isEmployee()
                  || (isSignedIn() && resource.data.customerId == request.auth.uid)
                  || (isDeliveryStaff() && ('assignedDeliveryDriverId' in resource.data && resource.data.assignedDeliveryDriverId == request.auth.uid));

      // Order creation: Only pending orders with pending payment status can be created
      allow create: if (isSignedIn()
                        && request.resource.data.customerId == request.auth.uid
                        && request.resource.data.orderStatus == 'pending'
                        && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == 'pending')
                        && (!('isReceiptVerified' in request.resource.data) || request.resource.data.isReceiptVerified != true))
                    || isAdmin();

      // Order updates: Strict field immutability for financials & statuses
      allow update: if isAdmin()
                    // Employees can update workflow statuses & verification, but CANNOT alter financial amounts
                    || (isEmployee()
                        && request.resource.data.customerId == resource.data.customerId
                        && request.resource.data.grandTotal == resource.data.grandTotal
                        && request.resource.data.subtotal == resource.data.subtotal
                        && request.resource.data.items == resource.data.items)
                    // Delivery staff can update delivery progression for assigned orders
                    || (isDeliveryStaff()
                        && 'assignedDeliveryDriverId' in resource.data
                        && resource.data.assignedDeliveryDriverId == request.auth.uid
                        && request.resource.data.customerId == resource.data.customerId
                        && request.resource.data.grandTotal == resource.data.grandTotal
                        && request.resource.data.subtotal == resource.data.subtotal)
                    // Customer can ONLY cancel own pending order; financial & payment fields are immutable
                    || (isOwner(resource.data.customerId)
                        && resource.data.orderStatus == 'pending'
                        && request.resource.data.orderStatus == 'cancelled'
                        && request.resource.data.customerId == resource.data.customerId
                        && request.resource.data.grandTotal == resource.data.grandTotal
                        && request.resource.data.subtotal == resource.data.subtotal
                        && request.resource.data.discount == resource.data.discount
                        && request.resource.data.tax == resource.data.tax
                        && request.resource.data.shippingFee == resource.data.shippingFee
                        && request.resource.data.paymentStatus == resource.data.paymentStatus
                        && request.resource.data.paymentReference == resource.data.paymentReference
                        && (!('isReceiptVerified' in resource.data) || request.resource.data.isReceiptVerified == resource.data.isReceiptVerified));

      // Only Admins can delete order records
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 8. RATINGS & REVIEWS
    // ===============================================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // ===============================================================
    // 9. NOTIFICATIONS
    // ===============================================================
    match /notifications/{notificationId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isEmployee() || isOwner(request.resource.data.userId);
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // ===============================================================
    // 10. INVENTORY AUDIT TRANSACTIONS
    // ===============================================================
    match /inventoryTransactions/{txId} {
      allow read, create: if isEmployee();
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // 11. DELIVERY ASSIGNMENTS & HANDOFFS
    // ===============================================================
    match /deliveryAssignments/{assignmentId} {
      allow read: if isEmployee() || (isDeliveryStaff() && resource.data.deliveryEmployeeId == request.auth.uid);
      allow create: if isEmployee();
      allow update: if isAdmin() || isEmployee() || (isDeliveryStaff() && resource.data.deliveryEmployeeId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /deliveryHandoffs/{handoffId} {
      allow read, create, update: if isEmployee();
      allow delete: if isAdmin();
    }

    match /deliveryEvents/{eventId} {
      allow read, create, update: if isEmployee();
      allow delete: if isAdmin();
    }

    match /packages/{packageId} {
      allow read, create, update: if isEmployee();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 12. CUSTOMER SUPPORT & COMMUNICATIONS
    // ===============================================================
    match /customerCommunications/{commId} {
      allow read, create, update: if isEmployee();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 13. ACTIVITY LOGS & AUDIT TRAILS
    // ===============================================================
    match /employeeActivityLogs/{logId} {
      allow read, create: if isEmployee();
      allow update, delete: if isAdmin();
    }

    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isEmployee() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /emailNotifications/{emailLogId} {
      allow read: if isAdmin() || (isSignedIn() && 'recipientEmail' in resource.data && resource.data.recipientEmail == request.auth.token.email);
      allow create: if isEmployee();
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // 14. STORE SETTINGS & CREDENTIALS
    // ===============================================================
    match /settings/{settingId} {
      allow read: if (settingId != 'admin_credentials' && settingId != 'secrets') || isAdmin();
      allow write: if isAdmin();
    }
  }
}
